---
description: >-
  Enrich already-built OCSF src/dst endpoints with the contextual FortiGate
  fields that accompany them: geo location, firewall address-object UUIDs,
  the MAC seen behind a NAT device, and the device fingerprint FortiOS derives
  from traffic.

  Call this after `src_endpoint`/`dst_endpoint` exist, since it only adds to
  them. Every field is optional, so log families that carry none are unaffected.
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

// `srccountry`/`dstcountry` are the GeoIP countries FortiOS resolved for the
// two addresses. FortiOS spells them as English country names rather than the
// ISO 3166-1 alpha-2 codes OCSF nominally documents. The name is kept verbatim
// because it is what Sentinel's ASIM `SrcGeoCountry`/`DstGeoCountry` expect,
// so passing the code through would force a reverse lookup one hop later.
//
// "Reserved" is FortiOS's placeholder for addresses with no geographic
// meaning (RFC 1918, loopback, multicast). It is not a country, so it is
// dropped rather than recorded as one.
if $event.fortinet.srccountry? != null and $event.fortinet.srccountry != "Reserved" {
  $event.ocsf.src_endpoint.location = {
    country: move $event.fortinet.srccountry,
  }
}
drop $event.fortinet.srccountry?

if $event.fortinet.dstcountry? != null and $event.fortinet.dstcountry != "Reserved" {
  $event.ocsf.dst_endpoint.location = {
    country: move $event.fortinet.dstcountry,
  }
}
drop $event.fortinet.dstcountry?

// `srcuuid`/`dstuuid` are the UUIDs of the firewall address objects that
// matched the endpoints, not identifiers of the hosts themselves. They are the
// stable handle for the configured object, which is what `uid` denotes here.
if $event.fortinet.srcuuid? != null {
  $event.ocsf.src_endpoint.uid = move $event.fortinet.srcuuid
}
if $event.fortinet.dstuuid? != null {
  $event.ocsf.dst_endpoint.uid = move $event.fortinet.dstuuid
}

// `mastersrcmac` identifies a host with multiple network interfaces. Prefer
// it for host correlation; retain a different interface MAC in unmapped.
if $event.fortinet.mastersrcmac? != null {
  $event.ocsf.src_endpoint.mac = move $event.fortinet.mastersrcmac
  if $event.fortinet.srcmac? == $event.ocsf.src_endpoint.mac {
    drop $event.fortinet.srcmac
  }
} else if $event.fortinet.srcmac? != null {
  $event.ocsf.src_endpoint.mac = move $event.fortinet.srcmac?
}

// `devtype` is the device class FortiOS fingerprints from traffic, e.g.
// "Windows PC" or "Router/NAT Device". OCSF types `endpoint.type` as a free
// string, so the FortiOS label carries over as-is.
if $event.fortinet.devtype? != null {
  $event.ocsf.src_endpoint.type = move $event.fortinet.devtype
}

// Deliberately left in `unmapped`:
//
// - `devcategory` is FortiOS's coarser grouping above `devtype`, and it mixes
//   operating-system families ("Windows", "Android") with hardware roles
//   ("Router", "Printer"). `os.type` would misfile the hardware roles and
//   `hw_info.vendor_name` would misfile the OS families, so neither is right
//   for the whole vocabulary. `devtype` above already carries the finer value.
// - `srcserver` is a 0/1 flag marking whether the source acted as the server
//   side of the session. It qualifies the endpoint rather than describing it,
//   and the OCSF endpoint object has no slot for that.

// Endpoint names identify hosts, including names that parse_kv types as IPs
// or numbers. Keep authentication identities on their respective endpoints.
if $event.fortinet.srcname? != null {
  $event.ocsf.src_endpoint.hostname = (move $event.fortinet.srcname).string()
}
if $event.fortinet.dstname? != null {
  $event.ocsf.dst_endpoint.hostname = (move $event.fortinet.dstname).string()
}
if $event.fortinet.srcdomain? != null {
  $event.ocsf.src_endpoint.domain = (move $event.fortinet.srcdomain).string()
}
if $event.fortinet.srcmacvendor? != null {
  $event.ocsf.src_endpoint.mac_vendor = (move $event.fortinet.srcmacvendor).string()
}
if $event.fortinet.srccity? != null {
  $event.ocsf.src_endpoint.location.city = (move $event.fortinet.srccity).string()
}
if $event.fortinet.srcregion? != null {
  $event.ocsf.src_endpoint.location.region = (move $event.fortinet.srcregion).string()
}
if $event.fortinet.dstcity? != null {
  $event.ocsf.dst_endpoint.location.city = (move $event.fortinet.dstcity).string()
}
if $event.fortinet.dstregion? != null {
  $event.ocsf.dst_endpoint.location.region = (move $event.fortinet.dstregion).string()
}
if $event.fortinet.osname? != null {
  $event.ocsf.src_endpoint.os.name = (move $event.fortinet.osname).string()
}
if $event.fortinet.srcswversion? != null {
  $event.ocsf.src_endpoint.os.version = (move $event.fortinet.srcswversion).string()
}
if $event.fortinet.dstosname? != null {
  $event.ocsf.dst_endpoint.os.name = (move $event.fortinet.dstosname).string()
}
if $event.fortinet.dstswversion? != null {
  $event.ocsf.dst_endpoint.os.version = (move $event.fortinet.dstswversion).string()
}
if $event.fortinet.srchwvendor? != null {
  $event.ocsf.src_endpoint.hw_info.vendor_name = (move $event.fortinet.srchwvendor).string()
}
if $event.fortinet.dsthwvendor? != null {
  $event.ocsf.dst_endpoint.hw_info.vendor_name = (move $event.fortinet.dsthwvendor).string()
}
if $event.fortinet.dstdevtype? != null {
  $event.ocsf.dst_endpoint.type = (move $event.fortinet.dstdevtype).string()
}
if $event.fortinet.srcinetsvc? != null {
  $event.ocsf.src_endpoint.svc_name = (move $event.fortinet.srcinetsvc).string()
}
if $event.fortinet.dstinetsvc? != null {
  $event.ocsf.dst_endpoint.svc_name = (move $event.fortinet.dstinetsvc).string()
}
if $event.fortinet.user? != null {
  $event.ocsf.src_endpoint.owner.name = (move $event.fortinet.user).string()
}
if $event.fortinet.dstuser? != null {
  $event.ocsf.dst_endpoint.owner.name = (move $event.fortinet.dstuser).string()
}

if $event.fortinet.group? != null {
  $event.ocsf.src_endpoint.owner.groups = [{name: (move $event.fortinet.group).string()}]
}
// Master MAC identifies the host across its interfaces. Retain a differing
// interface MAC in unmapped instead of discarding it.
if $event.fortinet.masterdstmac? != null {
  $event.ocsf.dst_endpoint.mac = (move $event.fortinet.masterdstmac).string()
  if $event.fortinet.dstmac? == $event.ocsf.dst_endpoint.mac {
    drop $event.fortinet.dstmac
  }
} else if $event.fortinet.dstmac? != null {
  $event.ocsf.dst_endpoint.mac = (move $event.fortinet.dstmac).string()
}

// Passive identity discovery is useful even without firewall authentication.
// An authenticated name wins. Copy rather than move the fallback so unmapped
// preserves its unauthenticated provenance and the discovery-method fields.
if $event.ocsf.src_endpoint?.owner?.name? == null and $event.fortinet.unauthuser? != null {
  $event.ocsf.src_endpoint.owner.name = $event.fortinet.unauthuser.string()
}
if $event.ocsf.dst_endpoint?.owner?.name? == null and $event.fortinet.dstunauthuser? != null {
  $event.ocsf.dst_endpoint.owner.name = $event.fortinet.dstunauthuser.string()
}
