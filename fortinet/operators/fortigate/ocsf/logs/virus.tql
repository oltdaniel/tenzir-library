---
description: "FortiGate antivirus logs → OCSF Detection Finding (2004)"
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

@name = "ocsf.detection_finding"

$event.ocsf.category_uid = 2
$event.ocsf.class_uid = 2004
$event.ocsf.activity_id = 1  // Create
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

$event.ocsf.is_alert = true

drop $event.fortinet.eventtype

// `virus` is the malware name; `virusid` is the signature ID; `dtype` is the
// detection type FortiGuard assigned. OCSF classifies malware on its own enum,
// so the FortiOS label is translated rather than passed through; anything
// outside the known set becomes Unknown (0) instead of being forced to Virus.
let $classifications = {
  Virus: 19,
  Botnet: 3,
  Trojan: 17,
  Worm: 20,
  Adware: 1,
  Spyware: 16,
  Rootkit: 14,
  Ransomware: 13,
  Backdoor: 2,
}
$event.ocsf.malware = [{
  name: move $event.fortinet.virus,
  uid: (move $event.fortinet.virusid).string(),
  classification_ids: [$classifications[$event.fortinet.dtype?]? else 0],
  provider: "FortiGate",
}]
drop $event.fortinet.dtype?

$event.ocsf.finding_info = {
  uid: $event.ocsf.malware[0].uid,
  title: $event.ocsf.malware[0].name,
  src_url: move $event.fortinet.ref,
  analytic: {
    type_id: 1,  // Rule
    name: $event.ocsf.malware[0].name,
  },
}

// `quarskip` states whether the infected file was quarantined and, when it was
// not, why. That is the outcome of the response FortiGate took, which is what
// `remediation.desc` records.
if $event.fortinet.quarskip? != null {
  $event.ocsf.remediation = {
    desc: move $event.fortinet.quarskip,
  }
}

// `analyticssubmit` is a boolean saying whether the sample was uploaded to
// FortiSandbox for further analysis. It describes the vendor's own downstream
// workflow rather than anything about the detection, and OCSF has no slot for
// that, so it stays in `unmapped`. The resulting checksum is mapped as a file
// hash by the evidence UDO below.

// Network context goes into evidences for Detection Finding.
fortinet::fortigate::ocsf::network_evidence event=$event

fortinet::fortigate::ocsf::security_control event=$event

if $event.fortinet.action? != null {
  $event.ocsf.disposition_id = fortinet::$utm_dispositions[move $event.fortinet.action]? else 0
}

// `crscore`/`crlevel` are the composite UTM risk score and level.
fortinet::fortigate::ocsf::risk event=$event
