---
description: "FortiGate traffic logs → OCSF Network Activity (4001)"
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

@name = "ocsf.network_activity"

// FortiGate traffic action → OCSF activity_id.
// Traffic logs are session-end summaries; action reflects how the session ended.
let $actions = {
  close: 2,         // normal TCP FIN
  accept: 6,        // flow accepted (typical for UDP or sniffer)
  "client-rst": 3,  // TCP RST from client
  "server-rst": 3,  // TCP RST from server
  deny: 5,          // blocked by policy before session established
  drop: 4,          // packet dropped mid-session
}

$event.ocsf.category_uid = 4
$event.ocsf.class_uid = 4001
$event.ocsf.activity_id = $actions[$event.fortinet.action]? else 0
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

$event.ocsf.src_endpoint = {
  ip: move $event.fortinet.srcip,
  port: move $event.fortinet.srcport,
  interface_name: move $event.fortinet.srcintf,
}
if $event.fortinet.srcname? != null {
  $event.ocsf.src_endpoint.name = (move $event.fortinet.srcname).string()
}

$event.ocsf.dst_endpoint = {
  ip: move $event.fortinet.dstip,
  port: move $event.fortinet.dstport,
  interface_name: move $event.fortinet.dstintf,
}
if $event.fortinet.dstname? != null {
  $event.ocsf.dst_endpoint.name = (move $event.fortinet.dstname).string()
}

// `service` is the application-layer protocol name identified by FortiGate.
$event.ocsf.app_protocol_name = move $event.fortinet.service

// A firewall observes the connection between the two endpoints rather than
// being either endpoint itself.
$event.ocsf.observation_point_id = 3

// `srcintfrole`/`dstintfrole` are the network zones of the ingress/egress
// interfaces (e.g. "lan", "wan", "dmz").
if $event.fortinet.srcintfrole? != null {
  $event.ocsf.src_endpoint.zone = move $event.fortinet.srcintfrole
}
if $event.fortinet.dstintfrole? != null {
  $event.ocsf.dst_endpoint.zone = move $event.fortinet.dstintfrole
}

// Geo location, address-object UUIDs, originator MAC, and device fingerprint.
// Traffic logs build their endpoints inline rather than through
// `network_endpoints`, so the shared context is applied explicitly here.
fortinet::fortigate::ocsf::endpoint_context event=$event

// Derives the session direction from those zones.
fortinet::fortigate::ocsf::connection_info event=$event

// `duration` is the session lifetime in seconds and `ocsf.time` is the end.
// FortiGate traffic logs are session summaries, so their counters describe
// cumulative lifetime traffic rather than a single observation interval.
$event.ocsf.duration = (move $event.fortinet.duration?).seconds().count_milliseconds().round()
$event.ocsf.end_time = $event.ocsf.time
$event.ocsf.start_time = $event.ocsf.end_time - $event.ocsf.duration.milliseconds()
$event.ocsf.cumulative_traffic = {
  bytes_in: move $event.fortinet.rcvdbyte,
  bytes_out: move $event.fortinet.sentbyte,
  packets_in: move $event.fortinet.rcvdpkt?,
  packets_out: move $event.fortinet.sentpkt,
  end_time: $event.ocsf.end_time,
  start_time: $event.ocsf.start_time,
  timespan: {
    duration: $event.ocsf.duration,
  },
}

// `trandisp` is the NAT type applied; `transip`/`transport` are the translated
// address/port. SNAT rewrites the source, DNAT rewrites the destination.
// transip=0.0.0.0 means no effective translation (e.g. sniffer mode).
if $event.fortinet.trandisp? == "snat" and $event.fortinet.transip? != 0.0.0.0 {
  $event.ocsf.src_endpoint.proxy_endpoint = {
    ip: move $event.fortinet.transip,
    port: move $event.fortinet.transport,
  }
} else if $event.fortinet.trandisp? == "dnat" and $event.fortinet.transip? != 0.0.0.0 {
  $event.ocsf.dst_endpoint.proxy_endpoint = {
    ip: move $event.fortinet.transip,
    port: move $event.fortinet.transport,
  }
}
drop $event.fortinet.trandisp?
drop $event.fortinet.transip?
drop $event.fortinet.transport?

// `app` is the application identified by deep packet inspection.
if $event.fortinet.app? != null {
  $event.ocsf.app_name = move $event.fortinet.app
}

// `sentdelta`/`rcvddelta` count the bytes transferred since the previous log
// entry for this session, which FortiOS emits for long-lived sessions. They
// describe one observation interval, so they belong in `traffic` next to the
// lifetime totals already recorded in `cumulative_traffic` above.
if $event.fortinet.sentdelta? != null or $event.fortinet.rcvddelta? != null {
  $event.ocsf.traffic = {
    bytes_in: move $event.fortinet.rcvddelta?,
    bytes_out: move $event.fortinet.sentdelta?,
  }
}

// `utmref` links this session summary to the UTM log records raised for the
// same session, in a `<serial>-<id>` form shared by both sides.
if $event.fortinet.utmref? != null {
  $event.ocsf.metadata.correlation_uid = (move $event.fortinet.utmref).string()
}

// `osname` is the source device OS as fingerprinted by FortiGate.
if $event.fortinet.osname? != null {
  $event.ocsf.src_endpoint.os = {
    name: move $event.fortinet.osname,
  }
}

// Traffic logs always reflect a firewall policy decision.
$event.ocsf.metadata.profiles = $event.ocsf.metadata.profiles.add("security_control")

// Firewall policy that matched the session.
// `poluuid` is the policy UUID (absent in local/multicast/sniffer logs);
// `policyid` is its numeric ID; `policytype` is the policy table
// (e.g., "policy", "local-in-policy", "multicast-policy", "sniffer").
$event.ocsf.firewall_rule = {
  uid: move $event.fortinet.poluuid?,
  name: (move $event.fortinet.policyid).string(),
  type: move $event.fortinet.policytype,
}

// Normalize the firewall decision. `utmaction` is the UTM/IPS outcome and
// takes precedence over the session-ending `action` when present.
$event.ocsf.action_id = 0
$event.ocsf.disposition_id = 0
if $event.fortinet.action? in ["accept", "close", "client-rst", "server-rst"] {
  $event.ocsf.action_id = 1
  $event.ocsf.disposition_id = 1
} else if $event.fortinet.action? == "deny" {
  $event.ocsf.action_id = 2
  $event.ocsf.disposition_id = 2
} else if $event.fortinet.action? == "drop" {
  $event.ocsf.action_id = 2
  $event.ocsf.disposition_id = 6
}
if $event.fortinet.utmaction? != null {
  let $security_actions = {
    allow: 1,
    block: 2,
  }
  let $security_dispositions = {
    allow: 1,
    block: 2,
  }
  $event.ocsf.action_id = $security_actions[$event.fortinet.utmaction]? else 0
  $event.ocsf.disposition_id = $security_dispositions[$event.fortinet.utmaction]? else 0
}
drop $event.fortinet.action?
drop $event.fortinet.utmaction?

// `applist` is the application-control profile that inspected the session.
// The firewall policy itself is already recorded as `firewall_rule` above, so
// `policy` is free to carry the security profile that acted on the traffic.
if $event.fortinet.applist? != null {
  $event.ocsf.policy = {
    name: move $event.fortinet.applist,
  }
}

// `crscore`/`crlevel` are the composite UTM risk score and level, and
// `apprisk` the application-control rating for `app`.
fortinet::fortigate::ocsf::risk event=$event
