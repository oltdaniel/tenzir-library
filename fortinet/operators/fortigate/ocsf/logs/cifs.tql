---
description: "FortiGate CIFS/SMB inspection logs → OCSF SMB Activity (4006)"
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

@name = "ocsf.smb_activity"

// CIFS file filter: a file was blocked or allowed during a file transfer.
// Map to File Open since the activity is a client trying to access a file.
$event.ocsf.category_uid = 4
$event.ocsf.class_uid = 4006
$event.ocsf.activity_id = 2  // File Open
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

drop $event.fortinet.eventtype

fortinet::fortigate::ocsf::network_endpoints event=$event
fortinet::fortigate::ocsf::connection_info event=$event

// CIFS is the application protocol of this SMB activity, rather than an
// endpoint service name duplicated from the same FortiGate field.
if $event.fortinet.service? != null {
  $event.ocsf.app_protocol_name = move $event.fortinet.service
}

// `filename` and `filesize` describe the file being transferred.
//
// `filetype` stays in `unmapped`: FortiOS reports a file *format* there
// ("msoffice", "pdf"), while OCSF's `file.type_id` enumerates file *kinds*
// (regular file, folder, symbolic link). Writing the format into that field
// would assert something the enum does not mean.
$event.ocsf.file = {
  name: (move $event.fortinet.filename?).string(),
  size: move $event.fortinet.filesize?,
}

fortinet::fortigate::ocsf::security_control event=$event

// `filtername` is the file-filter entry inside the CIFS profile that matched.
// `security_control` above has already put the profile itself in `policy.name`,
// so the matched entry is recorded as the rule beneath it.
if $event.fortinet.filtername? != null {
  $event.ocsf.firewall_rule = {
    ...$event.ocsf.firewall_rule?,
    name: (move $event.fortinet.filtername).string(),
  }
}

if $event.fortinet.action? != null {
  $event.ocsf.disposition_id = fortinet::$disposition_ids[move $event.fortinet.action]? else 0
}

if $event.fortinet.sharename? != null {
  $event.ocsf.share = (move $event.fortinet.sharename).string()
}
if $event.fortinet.pathname? != null {
  $event.ocsf.file.path = (move $event.fortinet.pathname).string()
}
