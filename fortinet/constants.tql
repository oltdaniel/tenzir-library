// Package-wide constants shared across the FortiGate OCSF log mappers.

// OCSF `status_id` for the FortiGate `status` field on event/* logs. FortiGate
// spells the failure case two ways: `event/user` and `event/endpoint` say
// "failed", while the IKE logs under `event/vpn` say "failure".
let $statuses = {success: 1, failed: 2, failure: 2}

// OCSF `disposition_id` values for FortiGate action vocabularies.
let $disposition_ids = {
  allow: 1,
  allowed: 1,
  pass: 1,
  exempt: 1,
  block: 2,
  blocked: 2,
  quarantine: 3,
  drop: 6,
  dropped: 6,
  clear_session: 6,
  log_only: 17,
  monitor: 17,
  monitored: 17,
  alert: 19,
  reset: 21,
}
