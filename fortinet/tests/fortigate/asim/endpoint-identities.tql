// Check both identity precedence and preservation through OCSF casting and ASIM.
from_file f"{env("TENZIR_INPUTS")}/traffic_forward_context.txt" {
  read_lines
}
fortinet = line.parse_kv()
fortinet::fortigate::ocsf::normalize fortinet, into=ocsf
this = ocsf
ocsf_derive
ocsf_cast
assert src_endpoint.hostname == "workstation.example.test"
assert dst_endpoint.hostname == "server.example.test"
assert src_endpoint.owner.name == "12345"
assert dst_endpoint.owner.name == "service-user"
assert src_endpoint.os.version == "11"
assert dst_endpoint.os.version == "6.8"
assert src_endpoint.location.city == "Berlin"
assert dst_endpoint.location.city == "Toronto"
assert src_endpoint.hw_info.vendor_name == "Dell"
assert dst_endpoint.hw_info.vendor_name == "Example"
assert connection_info.direction_id == 2
assert src_endpoint.zone == "Employees"
assert dst_endpoint.zone == "Internet"
assert src_endpoint.proxy_endpoint.ip == 172.16.200.2
assert dst_endpoint.proxy_endpoint.ip == 10.2.0.10
assert traffic.packets_out == 3 and traffic.packets_in == 4
assert traffic.timespan.duration == 5000
assert firewall_rule.name == "Employee Internet"
assert unmapped.policyid? == null
assert unmapped.unauthuser? == null
assert unmapped.dstunauthuser? == null
assert unmapped.srcmac? == null
assert unmapped.dstmac? == null
microsoft::sentinel::map
assert SrcUsername == "12345" and DstUsername == "service-user"
assert SrcHostname == "workstation.example.test" and DstHostname == "server.example.test"
// ASIM records the source address before translation as SrcNatIpAddr.
assert SrcIpAddr == 172.16.200.2 and SrcNatIpAddr == 10.1.100.11
assert DstNatIpAddr == 10.2.0.10
assert AdditionalFields.ocsf_unmapped.dstunauthusersource == "ldap"
select EventSchema, SrcUsername, DstUsername, SrcHostname, DstHostname, SrcNatIpAddr, DstNatIpAddr
