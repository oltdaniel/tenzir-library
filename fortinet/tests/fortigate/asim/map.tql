from_file f"{env("TENZIR_INPUTS")}/*.txt" {
  read_lines
}
fortinet = line.parse_kv()
fortinet::fortigate::ocsf::map event=fortinet
this = fortinet
ocsf::derive
ocsf::cast
// Every class FortiGate produces must reach a Sentinel table: an ASIM schema
// where one exists, CommonSecurityLog otherwise. Nothing is filtered out here,
// so a class that stops mapping fails the test instead of vanishing.
microsoft::sentinel::map
sort
